                "f\"{attn_prefix}.compressor.wkv.weight\"",
                "f\"{attn_prefix}.indexer.kv_compressor.ape\"",
                "f\"{attn_prefix}.indexer.kv_compressor.norm.weight\"",
                "f\"{attn_prefix}.indexer.kv_compressor.wgate.weight\"",
