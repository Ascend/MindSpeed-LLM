{
    "contract": [
        {
            "params": {
                "head_dim": 8,
                "ratio_indexer": 4,
                "ratio_compressor_only": 128,
                "attn_prefix": "decoder.layers.0.self_attention",
                "mtp_prefix": "mtp.layers.0.transformer_layer.self_attention",
                "mg_compressor_keys": [
                    "compressor.ape",
                    "compressor.norm.weight",
                    "compressor.wgate.weight",
                    "compressor.wkv.weight"
                ],
                "mg_indexer_keys": [
                    "indexer.kv_compressor.ape",
                    "indexer.kv_compressor.norm.weight",
                    "indexer.kv_compressor.wgate.weight",
                    "indexer.kv_compressor.wkv.weight",
                    "indexer.wq_b.weight",
                    "indexer.weights_proj.weight"
                ]
            }
        }
    ],
    "base_args": [
        {
            "params": {
                "hidden_size": 16,
                "qk_pos_emb_head_dim": 4,
                "rope_head_dim": 4,
                "norm_epsilon": 1e-6,
                "fp8": null,
                "kv_compress": true,
                "index_n_heads": 4,
                "index_head_dim": 8,
                "index_topk": 8,
                "q_lora_rank": 8,
                "use_fused_lightning_indexer": false,
                "compress_ratios": [4],
                "scale_fmt": null
            }
        }
    ],
