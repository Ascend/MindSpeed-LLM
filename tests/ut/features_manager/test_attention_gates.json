    "test_deepseek_cp_rejects_incompatible_features": [
        {
            "values": {
                "use_sparse_flash_attn": false
            },
            "message": "requires --use-sparse-flash-attn"
        },
        {
            "values": {
                "recompute_csa_attention": true
            },
            "message": "does not support --recompute-csa-attention"
        },
        {
            "values": {
                "enable_dsa_indexer": true,
                "kv_compress": false
            },
            "message": "requires --kv-compress"
        },
        {
            "values": {
                "indexer_qk_quant_scheme": "mxfp8"
            },
            "message": "does not support --indexer-qk-quant-scheme"
        },
        {
            "values": {
                "compress_ratios": [
                    2
                ]
            },
            "message": "only supports compression ratios 0, 1, 4, and 128"
        },
        {
            "values": {
                "compress_ratios": [
                    0,
                    4,
                    32
                ]
            },
            "message": "got \\[32\\]"
        },
        {
            "values": {
                "enable_dsa_indexer": true,
                "kv_compress": true,
                "indexer_loss_coeff": 1.0,
                "use_fused_lightning_indexer": false
            },
            "message": "requires --use-fused-lightning-indexer$"
        },
        {
            "values": {
                "enable_dsa_indexer": true,
                "kv_compress": true,
                "indexer_loss_coeff": "0.5",
                "use_fused_lightning_indexer": true,
                "use_fused_lightning_indexer_loss": false
            },
            "message": "requires --use-fused-lightning-indexer-loss"
        }
    ],
    "test_deepseek_cp_accepts_supported_features": [
        {
            "values": {}
        },
        {
            "values": {
                "spec": "custom.deepseek4_spec"
            }
        },
        {
            "values": {
                "spec": [
                    "custom.deepseek4_spec",
                    "get_spec"
                ]
            }
        },
        {
            "values": {
                "compress_ratios": null
            }
        },
        {
            "values": {
                "compress_ratios": []
            }
        },
        {
            "values": {
                "compress_ratios": [
                    0,
                    1,
                    4,
                    128
                ]
            }
        },
        {
            "values": {
                "compress_ratios": [
                    "4",
                    "128"
                ]
            }
        },
        {
            "values": {
                "enable_dsa_indexer": true,
                "kv_compress": true,
                "indexer_loss_coeff": 0.0
            }
        },
        {
            "values": {
                "enable_dsa_indexer": true,
                "kv_compress": true,
                "indexer_loss_coeff": 1.0,
                "use_fused_lightning_indexer": true,
                "use_fused_lightning_indexer_loss": true
            }
        },
        {
            "values": {
                "context_parallel_size": 1,
                "use_sparse_flash_attn": false,
