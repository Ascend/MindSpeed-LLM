    "test_dsa_dependencies_and_quantization": [
        {
            "values": {
                "multi_latent_attention": false
            },
            "message": "only supported in MLA"
        },
        {
            "values": {
                "use_flash_attn": false
            },
            "message": "only supported in FA"
        },
        {
            "values": {
                "context_parallel_size": 2,
                "context_parallel_algo": "megatron_cp_algo"
            },
            "message": "when use context parallel"
        },
        {
            "values": {
                "reset_attention_mask": true
            },
            "message": "requires --use-fused-lightning-indexer"
        },
        {
            "values": {
                "reset_attention_mask": true,
                "use_fused_lightning_indexer": true,
                "use_fused_lightning_indexer_loss": true
            },
            "message": "requires --use-sparse-flash-attn"
        },
        {
            "values": {
                "indexer_qk_quant_scheme": "mxfp8",
                "enable_dsa_indexer": false
            },
            "message": "requires --enable-dsa-indexer"
        },
        {
            "values": {
                "indexer_qk_quant_scheme": "mxfp8"
            },
            "message": "requires --kv-compress"
        },
        {
            "values": {
                "indexer_qk_quant_scheme": "mxfp8",
                "kv_compress": true,
                "use_fused_lightning_indexer": true,
                "use_fused_lightning_indexer_loss": true
            },
            "message": "not compatible"
        }
    ],
