    "test_router_validation_boundaries": [
        {
            "values": {
                "moe_expert_capacity_factor": 1,
                "moe_token_dispatcher_type": "allgather"
            },
            "exception": "ValueError",
            "message": "allgather"
        },
        {
            "values": {
                "moe_expert_capacity_factor": 1,
                "moe_router_load_balancing_type": "seq_aux_loss"
            },
            "exception": "ValueError",
            "message": "aux_loss or none"
        },
        {
            "values": {
                "moe_expert_capacity_factor": 1,
                "shared_expert_gate_output_dimension": 2
            },
            "exception": "AssertionError",
            "message": "gate output dimension"
        },
        {
            "values": {
                "moe_router_load_balancing_type": "group_limited_greedy",
                "moe_router_group_topk": null
            },
            "exception": "AssertionError",
            "message": "topk-group"
        },
        {
            "values": {
                "moe_router_load_balancing_type": "group_limited_greedy",
                "moe_router_topk_scaling_factor": null
            },
            "exception": "AssertionError",
            "message": "scaling-factor"
        },
        {
            "values": {
                "moe_router_load_balancing_type": "group_limited_greedy",
                "moe_router_group_topk": 4
            },
            "exception": "AssertionError",
            "message": "less than"
        },
        {
            "values": {
                "moe_router_enable_expert_bias": true,
                "moe_router_score_function": "invalid"
            },
            "exception": "ValueError",
            "message": "Expert bias"
        },
        {
            "values": {
                "n_hash_layers": 5
            },
            "exception": "ValueError",
            "message": "one PP stage"
        },
        {
            "values": {
                "n_hash_layers": 3,
                "num_layers_per_virtual_pipeline_stage": 2
            },
            "exception": "ValueError",
            "message": "one VPP stage"
        }
    ],
