            "expected_endswith": "{ASSISTANT}{THINKING_START}"
        }
    ],
    "test_encode_arguments_to_dsml": [
        {
            "label": "mixed_types",
            "arguments": "{\"a\": \"x\", \"b\": 2}",
            "expected_contains": [
                "<\uff5cDSML\uff5cparameter name=\"a\" string=\"true\">x</\uff5cDSML\uff5cparameter>",
                "<\uff5cDSML\uff5cparameter name=\"b\" string=\"false\">2</\uff5cDSML\uff5cparameter>"
            ]
        },
        {
            "label": "invalid_json_falls_back",
            "arguments": "raw text",
            "expected_contains": [
                "<\uff5cDSML\uff5cparameter name=\"arguments\" string=\"true\">raw text</\uff5cDSML\uff5cparameter>"
            ]
        }
    ],
    "test_deepseek4_encode_oneturn": [
        {
            "label": "chat_mode",
            "enable_thinking": false,
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                },
                {
                    "role": "assistant",
                    "content": "hello"
                }
            ],
            "expected_prompt_exact": "{BOS}<\uff5cUser\uff5c>hi<\uff5cAssistant\uff5c></think>",
            "expected_prompt_endswith": null,
            "expected_response_exact": "hello{EOS}"
        },
        {
            "label": "thinking_mode_keeps_reasoning_in_response",
            "enable_thinking": null,
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                },
                {
                    "role": "assistant",
                    "content": "<think>why</think>hello"
                }
            ],
            "expected_prompt_exact": null,
            "expected_prompt_endswith": "<\uff5cAssistant\uff5c><think>",
            "expected_response_exact": "why</think>hello{EOS}"
        },
        {
            "label": "prompt_keeps_text_after_last_assistant",
            "enable_thinking": null,
            "messages": [
                {
                    "role": "user",
                    "content": "q"
                },
                {
                    "role": "assistant",
                    "content": "a"
                },
                {
                    "role": "user",
                    "content": "next"
                }
            ],
            "expected_prompt_exact": "{BOS}<\uff5cUser\uff5c>q<\uff5cAssistant\uff5c></think><\uff5cUser\uff5c>next<\uff5cAssistant\uff5c><think>",
            "expected_prompt_endswith": null,
            "expected_response_exact": "a{EOS}"
        }
    ],
    "test_deepseek4_encode_multiturn": [
        {
            "label": "returns_pairs_per_assistant_turn",
            "messages": [
                {
                    "role": "user",
                    "content": "q1"
                },
                {
                    "role": "assistant",
                    "content": "<think>r</think>a1"
                },
                {
                    "role": "user",
                    "content": "q2"
                },
                {
                    "role": "assistant",
                    "content": "a2"
                }
            ],
            "expected_response_exacts": [
                "a1{EOS}",
                "</think>a2{EOS}"
            ]
        }
    ]
}
