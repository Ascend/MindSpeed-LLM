    "test_normalize_to_v4_schema": [
        {
            "label": "system_synthesized_when_no_system_message",
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                }
            ],
            "system": "SYS",
            "tools": null,
            "expected_subset": [
                {
                    "role": "system",
                    "content": "SYS"
                },
                {
                    "role": "user"
                }
            ]
        },
        {
            "label": "system_merges_into_first_system_message",
            "messages": [
                {
                    "role": "system",
                    "content": "first"
                }
            ],
            "system": "SYS",
            "tools": null,
            "expected_subset": [
                {
                    "content": "SYS\n\nfirst"
                }
            ]
        },
        {
            "label": "tools_merge_into_first_system_message",
            "messages": [
                {
                    "role": "system",
                    "content": "first"
                }
            ],
            "system": null,
            "tools": "[{\"type\": \"function\", \"function\": {\"name\": \"f\"}}]",
            "expected_subset": [
                {
                    "tools": [
                        {
                            "type": "function",
                            "function": {
                                "name": "f"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "assistant_think_block_is_split",
            "messages": [
                {
                    "role": "assistant",
                    "content": "<think> why </think> answer"
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "reasoning_content": "why",
                    "content": "answer"
                }
            ]
        },
        {
            "label": "assistant_explicit_reasoning_content",
            "messages": [
                {
                    "role": "assistant",
                    "content": "c",
                    "reasoning_content": null
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "reasoning_content": "",
                    "content": "c"
                }
            ]
        },
        {
            "label": "tool_role_becomes_tool",
            "messages": [
                {
                    "role": "tool",
                    "content": "r",
                    "tool_call_id": "t1"
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "role": "tool",
                    "content": "r",
                    "tool_call_id": "t1"
                }
            ]
        },
        {
            "label": "function_role_becomes_tool",
            "messages": [
                {
                    "role": "function",
                    "content": "r",
                    "tool_call_id": "t1"
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "role": "tool",
                    "content": "r",
                    "tool_call_id": "t1"
                }
            ]
        },
        {
            "label": "observation_role_becomes_tool",
            "messages": [
                {
                    "role": "observation",
                    "content": "r",
                    "tool_call_id": "t1"
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "role": "tool",
                    "content": "r",
                    "tool_call_id": "t1"
                }
            ]
        },
        {
            "label": "system_message_keeps_tools_key",
            "messages": [
                {
                    "role": "system",
                    "content": "s",
                    "tools": [
                        {
                            "type": "function",
                            "function": {
                                "name": "f"
                            }
                        }
                    ]
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "tools": [
                        {
                            "type": "function",
                            "function": {
                                "name": "f"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "developer_and_latest_reminder_pass_through",
            "messages": [
                {
                    "role": "developer",
                    "content": "dev"
                },
                {
                    "role": "latest_reminder",
                    "content": "rem"
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "role": "developer"
                },
                {
                    "role": "latest_reminder"
                }
            ]
        },
        {
            "label": "user_extra_keys_are_kept",
            "messages": [
                {
                    "role": "user",
                    "content": "u",
                    "task": "query",
                    "mask": true,
                    "wo_eos": true
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "task": "query",
                    "mask": true,
                    "wo_eos": true
                }
            ]
        },
        {
            "label": "assistant_tool_calls_are_kept",
            "messages": [
                {
                    "role": "assistant",
                    "content": "",
                    "tool_calls": [
                        {
                            "id": "t1",
                            "function": {
                                "name": "f",
                                "arguments": "{}"
                            }
                        }
                    ]
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "tool_calls": [
                        {
                            "id": "t1",
                            "function": {
                                "name": "f",
                                "arguments": "{}"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "attaches_tools_to_synthesized_system",
            "messages": [
                {
                    "role": "user",
                    "content": "u"
                }
            ],
            "system": null,
            "tools": "[{\"type\": \"function\", \"function\": {\"name\": \"f\"}}]",
            "expected_subset": [
                {
                    "role": "system",
                    "tools": [
                        {
                            "type": "function",
                            "function": {
                                "name": "f"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "keeps_assistant_task_and_wo_eos",
            "messages": [
                {
                    "role": "assistant",
                    "content": "a",
                    "task": "query",
                    "wo_eos": true,
                    "mask": true
                }
            ],
            "system": null,
            "tools": null,
            "expected_subset": [
                {
                    "task": "query",
                    "wo_eos": true,
                    "mask": true
                }
            ]
        }
    ],
