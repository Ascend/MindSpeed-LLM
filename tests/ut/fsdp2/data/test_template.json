{
    "test_encode_oneturn": [
        {
            "label": "splits_prompt_and_response",
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                },
                {
                    "role": "assistant",
                    "content": "yo"
                }
            ],
            "system": null,
            "tools": null,
            "default_system": null,
            "observation_slot": null,
            "expected_prompt_exact": "<s>User: hi\n",
            "expected_prompt_contains": null,
            "expected_prompt_not_contains": null,
            "expected_prompt_startswith": null,
            "expected_response_exact": "Assistant: yo\n",
            "expected_response_contains": null
        },
        {
            "label": "system_and_tools_are_encoded_into_first_turn",
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                },
                {
                    "role": "assistant",
                    "content": "ok"
                }
            ],
            "system": "Be nice",
            "tools": "[{\"name\": \"calculator\", \"description\": \"A simple calculator\", \"parameters\": {\"type\": \"object\", \"properties\": {\"expression\": {\"type\": \"string\", \"description\": \"the math expression\"}}, \"required\": [\"expression\"]}}]",
            "default_system": null,
            "observation_slot": null,
            "expected_prompt_exact": null,
            "expected_prompt_contains": [
                "System: Be nice",
                "Tool Name: calculator",
                "User: hi"
            ],
            "expected_prompt_not_contains": null,
            "expected_prompt_startswith": "<s>",
            "expected_response_exact": null,
            "expected_response_contains": null
        },
        {
            "label": "default_system_is_used_when_none_given",
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                },
                {
                    "role": "assistant",
                    "content": "ok"
                }
            ],
            "system": null,
            "tools": null,
            "default_system": "Be polite",
            "observation_slot": null,
            "expected_prompt_exact": null,
            "expected_prompt_contains": [
                "System: Be polite"
            ],
            "expected_prompt_not_contains": null,
            "expected_prompt_startswith": null,
            "expected_response_exact": null,
            "expected_response_contains": null
        },
        {
            "label": "explicit_system_overrides_default",
            "messages": [
                {
                    "role": "user",
                    "content": "hi"
                },
                {
                    "role": "assistant",
                    "content": "ok"
                }
            ],
            "system": "Be kind",
            "tools": null,
            "default_system": "Be polite",
            "observation_slot": null,
            "expected_prompt_exact": null,
            "expected_prompt_contains": [
                "System: Be kind"
            ],
            "expected_prompt_not_contains": [
                "Be polite"
            ],
            "expected_prompt_startswith": null,
            "expected_response_exact": null,
            "expected_response_contains": null
        },
        {
            "label": "function_role_is_encoded_through_tool_format",
            "messages": [
                {
                    "role": "user",
                    "content": "call it"
                },
                {
                    "role": "function",
                    "content": "[{\"name\": \"calculator\", \"arguments\": {\"expression\": \"1+1\"}}]"
                }
            ],
            "system": null,
            "tools": null,
            "default_system": null,
            "observation_slot": null,
            "expected_prompt_exact": null,
            "expected_prompt_contains": null,
            "expected_prompt_not_contains": null,
            "expected_prompt_startswith": null,
            "expected_response_exact": null,
            "expected_response_contains": [
                "Action: calculator",
                "Action Input: {\"expression\": \"1+1\"}"
            ]
        },
        {
            "label": "observation_role_uses_observation_formatter",
            "messages": [
                {
                    "role": "user",
                    "content": "look"
                },
                {
                    "role": "observation",
                    "content": "42"
                }
            ],
            "system": null,
            "tools": null,
            "default_system": null,
            "observation_slot": "Obs: {{content}}\n",
            "expected_prompt_exact": null,
            "expected_prompt_contains": null,
            "expected_prompt_not_contains": null,
            "expected_prompt_startswith": null,
            "expected_response_exact": null,
            "expected_response_contains": [
                "Obs: 42"
            ]
        }
    ],
    "test_encode_multiturn": [
        {
            "label": "returns_one_pair_per_turn",
            "messages": [
                {
                    "role": "user",
                    "content": "q1"
                },
                {
                    "role": "assistant",
                    "content": "a1"
                },
                {
                    "role": "user",
                    "content": "q2"
                },
                {
                    "role": "assistant",
                    "content": "a2"
                }
            ],
            "expected_pairs": [
                [
                    "<s>User: q1\n",
                    "Assistant: a1\n"
                ],
                [
                    "User: q2\n",
                    "Assistant: a2\n"
                ]
            ]
        }
    ],
    "test_reasoning_encode_oneturn": [
        {
            "label": "adds_empty_thought_to_response",
            "enable_thinking": true,
            "messages": [
                {
                    "role": "user",
                    "content": "q1"
                },
                {
                    "role": "assistant",
                    "content": "<think>r1</think>a1"
                },
                {
                    "role": "user",
                    "content": "q2"
                },
                {
                    "role": "assistant",
                    "content": "a2"
                }
            ],
            "expected_prompt_contains": [
                "Assistant: a1"
            ],
            "expected_prompt_not_contains": [
                "r1"
            ],
            "expected_prompt_endswith": null,
            "expected_response_exact": "<think></think>Assistant: a2\n"
        },
        {
            "label": "nothink_puts_thought_in_prompt",
            "enable_thinking": false,
            "messages": [
                {
                    "role": "user",
                    "content": "q"
                },
                {
                    "role": "assistant",
                    "content": "a"
                }
            ],
            "expected_prompt_contains": null,
            "expected_prompt_not_contains": null,
            "expected_prompt_endswith": "<think></think>",
            "expected_response_exact": "Assistant: a\n"
        },
        {
            "label": "nothink_removes_existing_thought",
            "enable_thinking": false,
            "messages": [
                {
                    "role": "user",
                    "content": "q"
                },
                {
                    "role": "assistant",
                    "content": "<think>cot</think>a"
                }
            ],
            "expected_prompt_contains": null,
            "expected_prompt_not_contains": null,
            "expected_prompt_endswith": null,
            "expected_response_exact": "Assistant: a\n"
        }
    ],
