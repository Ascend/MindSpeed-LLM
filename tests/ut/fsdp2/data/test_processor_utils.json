{
    "test_search_for_fit": [
        {
            "label": "largest_fitting_number",
            "numbers": [1, 3, 5, 7],
            "capacity": 6,
            "expected": 2
        },
        {
            "label": "exact_fit_is_preferred",
            "numbers": [2, 4, 6],
            "capacity": 4,
            "expected": 1
        },
        {
            "label": "nothing_fits",
            "numbers": [5, 10],
            "capacity": 4,
            "expected": -1
        },
        {
            "label": "empty_list",
            "numbers": [],
            "capacity": 10,
            "expected": -1
        }
    ],
    "test_greedy_knapsack": [
        {
            "label": "single_bin_when_everything_fits",
            "numbers": [1, 2, 3],
            "capacity": 10,
            "expected_bins": [[3, 2, 1]]
        },
        {
            "label": "fewest_bins_for_two_exact_pairs",
            "numbers": [3, 5, 2, 6],
            "capacity": 8,
            "expected_bins": [[6, 2], [5, 3]]
        },
        {
            "label": "empty_input",
            "numbers": [],
            "capacity": 8,
            "expected_bins": []
        }
    ],
    "test_infer_seqlen": [
        {
            "label": "target_short_truncates_source_to_cutoff",
            "source_len": 500,
            "target_len": 40,
            "cutoff_len": 128,
            "expected_source_len": 88,
            "expected_target_len": 40
        },
        {
            "label": "source_short_truncates_target",
            "source_len": 40,
            "target_len": 500,
            "cutoff_len": 128,
            "expected_source_len": 40,
            "expected_target_len": 88
        },
        {
            "label": "both_long_truncated_proportionally",
            "source_len": 1000,
            "target_len": 1000,
            "cutoff_len": 128,
            "expected_source_len": 64,
            "expected_target_len": 64
        },
        {
            "label": "never_exceeds_original_lengths",
            "source_len": 10,
            "target_len": 10,
            "cutoff_len": 128,
            "expected_source_len": 10,
            "expected_target_len": 10
        },
        {
            "label": "extreme_ratio_keeps_nonnegative_lengths",
            "source_len": 100000,
            "target_len": 1,
            "cutoff_len": 128,
            "expected_source_len": 127,
            "expected_target_len": 1
        }
    ]
}
