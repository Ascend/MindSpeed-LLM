{
    "test_optimizer_construction": [
        {
            "case": {
                "config": {},
                "has_params": true,
                "new_te": false,
                "scaler": "none",
                "name": "adam_bf16"
            }
        },
        {
            "case": {
                "config": {
                    "optimizer": "sgd"
                },
                "has_params": true,
                "new_te": false,
                "scaler": "none",
                "name": "sgd"
            }
        },
        {
            "case": {
                "config": {},
                "has_params": false,
                "new_te": false,
                "scaler": "none",
                "name": "empty_parameters"
            }
        },
        {
            "case": {
                "config": {
                    "use_precision_aware_optimizer": true
                },
                "has_params": true,
                "new_te": false,
                "scaler": "none",
                "name": "precision_aware_old_te"
            }
        },
        {
            "case": {
                "config": {
                    "use_precision_aware_optimizer": true
                },
                "has_params": true,
                "new_te": true,
                "scaler": "none",
                "name": "precision_aware_new_te"
            }
        },
        {
            "case": {
                "config": {
                    "loss_scale": 16
                },
                "has_params": true,
                "new_te": false,
                "scaler": "constant",
                "name": "constant_scaler"
            }
        },
        {
            "case": {
                "config": {
                    "fp16": true,
                    "bf16": false,
                    "loss_scale": 32
                },
                "has_params": true,
                "new_te": false,
                "scaler": "constant",
                "name": "constant_overrides_fp16"
            }
        },
        {
            "case": {
                "config": {
                    "fp16": true,
                    "bf16": false
                },
                "has_params": true,
                "new_te": false,
                "scaler": "dynamic",
                "name": "fp16_dynamic"
            }
        },
        {
            "case": {
                "config": {
                    "bf16": false
                },
                "has_params": true,
                "new_te": false,
                "scaler": "none",
                "name": "distributed_fp32_params"
            }
        },
        {
            "case": {
                "config": {
                    "fp16": true,
                    "bf16": false,
                    "use_distributed_optimizer": false
                },
                "has_params": true,
                "new_te": false,
                "scaler": "dynamic",
                "name": "fp16_local"
            }
        },
        {
            "case": {
                "config": {
                    "use_distributed_optimizer": false
                },
                "has_params": true,
                "new_te": false,
                "scaler": "none",
                "name": "bf16_local"
            }
        },
        {
            "case": {
                "config": {
                    "fp16": true,
                    "bf16": false,
                    "use_distributed_optimizer": false
                },
                "has_params": false,
                "new_te": false,
                "scaler": "dynamic",
                "name": "empty_fp16_local"
            }
        }
    ],
    "test_adam_state": [
        {
            "case": {
                "name": "normal",
                "precision_aware": false,
                "existing": false,
                "omit_config": false
            }
        },
        {
            "case": {
                "name": "no_config",
                "precision_aware": false,
                "existing": false,
                "omit_config": true
            }
        },
        {
            "case": {
                "name": "precision_aware",
                "precision_aware": true,
                "existing": false,
                "omit_config": false
            }
        },
        {
            "case": {
                "name": "preserve_normal",
                "precision_aware": false,
                "existing": true,
                "omit_config": false
            }
        },
        {
            "case": {
                "name": "preserve_precision_aware",
                "precision_aware": true,
                "existing": true,
                "omit_config": false
            }
        },
        {
            "case": {
                "name": "precision_aware_without_config",
                "precision_aware": true,
                "existing": false,
                "omit_config": true
            }
        }
    ],
