    "test_cpu_offload": [
        {
            "case": {
                "name": "adam_old_torch",
                "config": {
                    "optimizer": "adam"
                },
                "torch_version": "2.2.0",
                "warn": true
            }
        },
        {
            "case": {
                "name": "adam_full_offload",
                "config": {
                    "optimizer": "adam",
                    "optimizer_offload_fraction": 1.0,
                    "pin_cpu_params": true
                },
                "torch_version": "2.3.0",
                "warn": false
            }
        },
        {
            "case": {
                "name": "sgd_old_torch",
                "config": {
                    "optimizer": "sgd"
                },
                "torch_version": "2.2.0",
                "warn": true
            }
        },
        {
            "case": {
                "name": "sgd_no_overlap",
                "config": {
                    "optimizer": "sgd",
                    "optimizer_offload_fraction": 0.0,
                    "overlap_cpu_optimizer_d2h_h2d": false,
                    "pin_cpu_grads": false
                },
                "torch_version": "2.7.1",
                "warn": false
            }
        }
    ],
    "test_invalid_optimizer": [
        {
            "case": {
                "name": "unsupported",
                "config": {
                    "optimizer": "invalid"
                },
                "error": "invalid optimizer is not supported"
            }
        },
        {
            "case": {
                "name": "ha_fp32",
                "config": {
                    "fp16": false,
                    "bf16": false,
                    "use_distributed_optimizer": false
                },
                "error": "High availability do not support FP32"
            }
        }
    ],
    "test_model_grouping": [
        {
            "case": {
                "name": "single_dense",
                "overlap": false,
                "custom_fsdp": false,
                "moe": false,
                "full_size": 4
            }
        },
        {
            "case": {
                "name": "dense_and_expert",
                "overlap": false,
                "custom_fsdp": false,
                "moe": true,
                "full_size": 8
            }
        },
        {
            "case": {
                "name": "overlap_dense",
                "overlap": true,
                "custom_fsdp": false,
                "moe": false,
                "full_size": 8
            }
        },
        {
            "case": {
                "name": "overlap_and_expert",
                "overlap": true,
                "custom_fsdp": false,
                "moe": true,
                "full_size": 4
            }
        },
        {
            "case": {
                "name": "custom_fsdp_single",
                "overlap": false,
                "custom_fsdp": true,
                "moe": true,
                "full_size": 4
            }
        },
        {
            "case": {
                "name": "custom_fsdp_overlap",
                "overlap": true,
                "custom_fsdp": true,
                "moe": false,
                "full_size": 8
            }
        }
    ]
